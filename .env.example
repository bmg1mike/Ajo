DATABASE_URL=postgresql+psycopg://ajo:ajo@localhost:5432/ajo
HASH_SALT=
# Bot token from @BotFather; the bot long-polls, so no public URL is needed.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to run admin commands (milestone 5).
ADMIN_IDS=
LLM_ENABLED=false
# Any OpenAI-compatible chat completions API, e.g. https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional: set LLM_TEMPERATURE=0 for non-reasoning models; reasoning models reject it.
LLM_TEMPERATURE=
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=60
LLM_CACHE=true
STT_ENABLED=false
STT_BACKEND=local
GROQ_API_KEY=
TTS_MODEL_YO=facebook/mms-tts-yor
EMBED_MODEL=intfloat/multilingual-e5-small
RETRIEVAL_MIN_SCORE=0.80
