DATABASE_URL=postgresql+psycopg://ajo:ajo@localhost:5432/ajo
HASH_SALT=
# Bot token from @BotFather; the bot long-polls, so no public URL is needed.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to run /seed_demo, /simulate_day, /simulate_week,
# /reset_demo and /demo_status.
ADMIN_IDS=
LLM_ENABLED=false
# Any OpenAI-compatible chat completions API, e.g. https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional: set LLM_TEMPERATURE=0 for non-reasoning models; reasoning models reject it.
LLM_TEMPERATURE=
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=60
LLM_CACHE=true
STT_ENABLED=false
STT_BACKEND=local
GROQ_API_KEY=
TTS_MODEL_YO=facebook/mms-tts-yor
EMBED_MODEL=intfloat/multilingual-e5-small
RETRIEVAL_MIN_SCORE=0.80
# Run each circle's daily jobs (lesson post, personas, circle update) when the virtual clock passes
# LESSON_TIME (HH:MM, UTC). /simulate_day works either way and never double-runs a day.
SCHEDULER_ENABLED=false
LESSON_TIME=07:00
DEMO_GOAL=jamb_bio
# Hand-checked opportunities shown in weekly payouts; check them with python -m app.core.opportunities.
OPPORTUNITIES_FILE=data/opportunities.json
